# Copy to .env and edit. Every line is optional; the value shown is the default.
# The service reads .env from its working directory, or you can set real environment variables.

# --- Server -----------------------------------------------------------------------------
VALIDATOR_PORT=4567
VALIDATOR_HOST=0.0.0.0
LOG_LEVEL=INFO

# --- Terminology server ------------------------------------------------------------------
# A FHIR R4 terminology server. It is asked to validate codes in big code systems we cannot
# bundle (SNOMED CT, LOINC, RxNorm, UCUM) and to check them against value sets, including
# your own. It must implement the standard FHIR R4 terminology API:
#   POST [base]/ValueSet/$validate-code   and   POST [base]/CodeSystem/$validate-code
#
# Default: HL7's public server. http://tx.fhir.org is used as https://tx.fhir.org/r4
# (software: https://github.com/HealthIntersections/fhirserver).
# For your own server give the full R4 base URL, e.g. https://tx.example.org/fhir
TX_SERVER_URL=http://tx.fhir.org
TX_TIMEOUT_SECONDS=10

# Turn the terminology server OFF. WARNING: the variable disables it whenever it is SET,
# whatever the value ("false" and "0" also disable it). To keep it on, leave this line out.
# With it off, SNOMED/LOINC/RxNorm/UCUM codes only produce a warning ("cannot be validated").
# DISABLE_TX=true

# A wrong display text for a code is an error; set to true to make it a warning.
DISPLAY_ISSUES_ARE_WARNINGS=false

# --- Implementation guides (NPM packages) ------------------------------------------------
PACKAGES_REGISTRY_URL=https://packages.fhir.org
# Guides to load at every start, comma separated, as id#version (or just id for the latest):
# PRELOAD_IGS=hl7.fhir.us.core#3.1.1,my.country.in#1.0.0
# By default a guide that cannot be loaded is logged and startup continues. Set to true to stop startup instead:
# PRELOAD_IGS_STRICT=false
# Use only packages already in the cache, never download:
# PACKAGES_OFFLINE=true
# PACKAGE_CACHE_DIR=~/.cache/fhir-r4-validator/packages

# --- Data locations (rarely changed) -----------------------------------------------------
# DATA_DIR=./data
# Folder of .tgz implementation guides loaded at startup (empty by default)
# IGS_DIR=./igs
